{
  "productName": "LANDrop",
  "version": "0.2.0",
  "identifier": "com.landrop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1424",
    "devUrl": "http://127.0.0.1:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LANDrop",
        "width": 1180,
        "height": 800,
        "minWidth": 740,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Secure local network file transfer",
    "resources": {
      "sidecar/landrop-service/": "landrop-service/"
    }
  }
}
